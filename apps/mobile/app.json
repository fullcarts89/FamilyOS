{
  "expo": {
    "name": "FamilyOS",
    "slug": "familyos",
    "owner": "thoroxnard",
    "scheme": "familyos",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "icon": "./assets/branding/app-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.familyos.household",
      "appleTeamId": "G3FXWBPJY2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.familyos.household"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/android-adaptive-foreground.png",
        "backgroundColor": "#F7F5F0",
        "monochromeImage": "./assets/branding/android-adaptive-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      ["expo-router", { "asyncRoutes": false }],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "4f13afac-e536-4da6-948e-8dbc6ed7ea00"
      }
    }
  }
}
