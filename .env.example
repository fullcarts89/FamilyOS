# Local development only. Values come from `supabase status` after `pnpm stack:up`.
# The local stack runs on 553xx ports so it can sit beside other local Supabase projects.

# API (apps/api)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
API_PORT=8787
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_JWKS_URL=http://127.0.0.1:55321/auth/v1/.well-known/jwks.json
# SECRET_KEY from `supabase status`. Server-side only; never put it in the mobile app.
SUPABASE_SECRET_KEY=

# Mobile app (apps/mobile). Publishable values only: these ship inside the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# PUBLISHABLE_KEY from `supabase status`.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
