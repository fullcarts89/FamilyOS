{
  "name": "familyos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @familyos/e2e test",
    "licenses:check": "node scripts/check-licenses.mjs",
    "stack:up": "supabase start",
    "stack:down": "supabase stop",
    "stack:reset": "supabase db reset",
    "dev:api": "pnpm --filter @familyos/api dev",
    "dev:worker": "pnpm --filter @familyos/worker dev",
    "dev:mobile": "pnpm --filter @familyos/mobile start",
    "demo:seed": "pnpm --filter @familyos/api demo:seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
